APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DATA_ROOT=demo-data

# Storage: local (default) or azure_blob. Missing Azure config never falls back to local.
STORAGE_BACKEND=local
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_BLOB_CONTAINER=cvs-review-portal

# Identity: disabled (fail closed) | development (loopback only) | azure_app_service
# Development mode is NOT enabled automatically when production identity is absent.
IDENTITY_MODE=development
DEVELOPMENT_ACTOR=local-dev-reviewer
# Comma-separated allowed actors (required for azure_app_service; optional filter for development).
# Azure App Service canonical actor format: aad:{tenant_id}:{object_id}
# Example: ALLOWED_ACTORS=aad:11111111-1111-1111-1111-111111111111:22222222-2222-2222-2222-222222222222
ALLOWED_ACTORS=local-dev-reviewer
